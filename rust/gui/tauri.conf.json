{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPSherpa",
  "version": "0.1.1",
  "identifier": "com.arcusphenix.ipsherpa",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "IPSherpa — DHCP scope browser",
      "width": 1040,
      "height": 760,
      "minWidth": 620,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
